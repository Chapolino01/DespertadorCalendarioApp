<Window x:Class="DespertadorApp.AlarmasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alarmas" Height="500" Width="480"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        Background="#0F1B33"
        Foreground="{StaticResource TextoPrincipal}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Nueva alarma" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="Hora (HH:mm)" FontSize="12" Foreground="{StaticResource TextoSecundario}" Margin="0,0,0,4"/>
            <TextBox x:Name="txtHora" Text="07:00" Width="100" HorizontalAlignment="Left"
                     Style="{StaticResource CampoStyle}"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock Text="Días" FontSize="12" Foreground="{StaticResource TextoSecundario}" Margin="0,0,0,6"/>
            <WrapPanel>
                <CheckBox x:Name="chkLun" Content="Lun" IsChecked="True" Style="{StaticResource CheckStyle}" Margin="0,0,14,6"/>
                <CheckBox x:Name="chkMar" Content="Mar" IsChecked="True" Style="{StaticResource CheckStyle}" Margin="0,0,14,6"/>
                <CheckBox x:Name="chkMie" Content="Mié" IsChecked="True" Style="{StaticResource CheckStyle}" Margin="0,0,14,6"/>
                <CheckBox x:Name="chkJue" Content="Jue" IsChecked="True" Style="{StaticResource CheckStyle}" Margin="0,0,14,6"/>
                <CheckBox x:Name="chkVie" Content="Vie" IsChecked="True" Style="{StaticResource CheckStyle}" Margin="0,0,14,6"/>
                <CheckBox x:Name="chkSab" Content="Sáb" Style="{StaticResource CheckStyle}" Margin="0,0,14,6"/>
                <CheckBox x:Name="chkDom" Content="Dom" Style="{StaticResource CheckStyle}" Margin="0,0,14,6"/>
            </WrapPanel>
        </StackPanel>

        <Button Grid.Row="3" Content="Agregar alarma" Style="{StaticResource BotonPrimarioStyle}"
                Click="Agregar_Click" Margin="0,0,0,12"/>

        <ListBox Grid.Row="4" x:Name="lstAlarmas" Style="{StaticResource ListaStyle}"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Activar / Desactivar" Style="{StaticResource BotonStyle}"
                    Click="Alternar_Click" Margin="0,0,10,0"/>
            <Button Content="Eliminar" Style="{StaticResource BotonStyle}" Click="Eliminar_Click"/>
        </StackPanel>
    </Grid>
</Window>