<Window x:Class="DespertadorApp.EventosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Eventos" Height="540" Width="520"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        Background="#0F1B33"
        Foreground="{StaticResource TextoPrincipal}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Nuevo evento" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="Título" FontSize="12" Foreground="{StaticResource TextoSecundario}" Margin="0,0,0,4"/>
            <TextBox x:Name="txtTitulo" Style="{StaticResource CampoStyle}"/>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Fecha (dd/mm/aaaa)" FontSize="12" Foreground="{StaticResource TextoSecundario}" Margin="0,0,0,4"/>
                <TextBox x:Name="txtFecha" Style="{StaticResource CampoStyle}"/>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Avisar días antes" FontSize="12" Foreground="{StaticResource TextoSecundario}" Margin="0,0,0,4"/>
                <TextBox x:Name="txtDiasAntes" Text="3" Style="{StaticResource CampoStyle}"/>
            </StackPanel>
        </Grid>

        <Button Grid.Row="3" Content="Agregar evento" Style="{StaticResource BotonPrimarioStyle}"
                Click="Agregar_Click" Margin="0,0,0,12"/>

        <ListBox Grid.Row="4" x:Name="lstEventos" Style="{StaticResource ListaStyle}"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Eliminar seleccionado" Style="{StaticResource BotonStyle}"
                    Click="Eliminar_Click" Margin="0,0,10,0"/>
            <Button Content="Probar avisos" Style="{StaticResource BotonStyle}" Click="Probar_Click"/>
        </StackPanel>
    </Grid>
</Window>