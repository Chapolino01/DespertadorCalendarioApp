<Application x:Class="DespertadorApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <SolidColorBrush x:Key="TextoPrincipal" Color="#E6EDF7"/>
        <SolidColorBrush x:Key="TextoSecundario" Color="#8A97AD"/>
        <SolidColorBrush x:Key="Acento" Color="#3DD6B5"/>
        <SolidColorBrush x:Key="Tarjeta" Color="#1B2740"/>
        <SolidColorBrush x:Key="Borde" Color="#2E3C57"/>
        <SolidColorBrush x:Key="Campo" Color="#141E33"/>
        <SolidColorBrush x:Key="TarjetaInterna" Color="#16213A"/>

        <RadialGradientBrush x:Key="TarjetaFrase" Center="0.8,1" RadiusX="0.9" RadiusY="0.9">
            <GradientStop Color="#2A5F66" Offset="0"/>
            <GradientStop Color="#1B2740" Offset="1"/>
        </RadialGradientBrush>

        <LinearGradientBrush x:Key="FondoVentana" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0F1B33" Offset="0"/>
            <GradientStop Color="#0A1020" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="TarjetaStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Tarjeta}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Borde}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <Style x:Key="BotonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextoPrincipal}"/>
            <Setter Property="Background" Value="#24324F"/>
            <Setter Property="BorderBrush" Value="{StaticResource Borde}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="borde"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="borde" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BotonPrimarioStyle" TargetType="Button" BasedOn="{StaticResource BotonStyle}">
            <Setter Property="Background" Value="{StaticResource Acento}"/>
            <Setter Property="Foreground" Value="#0B1224"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="BotonIconoStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Foreground" Value="{StaticResource TextoPrincipal}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="borde" Background="{TemplateBinding Background}" CornerRadius="40">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="borde" Property="Background" Value="#2A3A5C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CampoStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Campo}"/>
            <Setter Property="Foreground" Value="{StaticResource TextoPrincipal}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextoPrincipal}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Borde}"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>

        <Style x:Key="CheckStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextoPrincipal}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="caja" Width="18" Height="18" CornerRadius="5"
                                    Background="{StaticResource Campo}"
                                    BorderBrush="{StaticResource Borde}"
                                    BorderThickness="1" VerticalAlignment="Center">
                                <Path x:Name="tilde" Data="M3,8 L6.5,11.5 L13,4"
                                      Stroke="#0B1224" StrokeThickness="2" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="caja" Property="Background" Value="{StaticResource Acento}"/>
                                <Setter TargetName="caja" Property="BorderBrush" Value="{StaticResource Acento}"/>
                                <Setter TargetName="tilde" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ListaItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextoPrincipal}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="borde" Background="Transparent" CornerRadius="8"
                                Padding="{TemplateBinding Padding}" Margin="2">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="borde" Property="Background" Value="#1F2C47"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="borde" Property="Background" Value="#2A3A5C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ListaStyle" TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource Campo}"/>
            <Setter Property="Foreground" Value="{StaticResource TextoPrincipal}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Borde}"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ListaItemStyle}"/>
        </Style>

    </Application.Resources>
</Application>